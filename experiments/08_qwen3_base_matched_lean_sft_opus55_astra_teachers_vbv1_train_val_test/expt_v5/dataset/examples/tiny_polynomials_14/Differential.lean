import Mathlib

namespace Tiny

def solution (x : Int) : Int := x ^ 3 - x

theorem spec_factor (x : Int) : solution x = x * (x - 1) * (x + 1) := by
  simp [solution]
  ring

theorem test_positive : solution 3 = 24 := by decide
theorem test_negative : solution (-2) = -6 := by decide

end Tiny
