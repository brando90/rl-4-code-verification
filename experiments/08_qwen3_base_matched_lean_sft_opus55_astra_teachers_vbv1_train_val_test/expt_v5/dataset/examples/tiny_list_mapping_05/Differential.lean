import Mathlib
namespace Tiny
def solution (xs : List Int) : List Int := xs.map (fun a => a * 2)
theorem spec_cons (a : Int) (xs : List Int) : solution (a :: xs) = (a * 2) :: solution xs := by rfl
theorem test_empty : solution [] = [] := by decide
theorem test_values : solution [-2, 0, 3] = [-4, 0, 6] := by decide
end Tiny
